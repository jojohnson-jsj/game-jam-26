[node name="Text" type="Label" parent="ColorRect/ScrollContainer/VBoxContainer/How to play/VBoxContainer/HBoxContainer" unique_id=1566257488]
custom_minimum_size = Vector2(10, 10)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0, 0, 0.086104214, 1)
text = "A - Day progress bar - shows how much time is left in the day
B - Trash can - Discards held items
C- Latte Machine - Produces lattes
D - Oven - Produces pies
E - Seated customers - Customers that have not been served will show a patience bar above their heads
F - Waiting customers - customers that have yet to be seated
G - Cat beds - For your current cats to rest on
H - You :)"
autowrap_mode = 3

