[node name="Text" type="RichTextLabel" parent="ColorRect/ScrollContainer/VBoxContainer/How to play/VBoxContainer" unique_id=354399168]
custom_minimum_size = Vector2(100, 100)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "Gameplay is split into day/night cycles, where you'll switch between running your cafe and customizing your cafe. 

During the day, you will cycle between greeting customers, taking orders, and making orders. [b]Interact[/b] with the customers at the door to greet them. Customers that have been greeted will automatically seat themselves and begin to look at the menu. When they are ready to orders, [b]interact[/b] again to take their orders. You can then [b]interact[/b] with the correct machine with their order to start preparing it, before bringing the finished item back to the table and [b]interacting[/b] with the customer to serve them. [b]Keep in mind you can only carry two items at a time! [/b]When the customer is finished eating, they will leave their payment on the table. [b]Interact [/b]with the table again to pick up their money. If you serve them quickly you may even get some extra money as a tip! 

Make sure you watch that patience bar! Patience will start winding down [b]as soon as the customer enters your cafe[/b], and customers that run out of patience will storm out!

During the night, you will be able to purchase more equipment for your cafe, switch around your cats, as well as gacha for new cats. You can buy new equipment and adopt new cats in the store. [b] Pulled cats can then be selected to be brought to the cafe in the My Cats menu [/b]in order to apply their buffs. You will need a free cat bed in order to bring a new cat. Cats that are brought to the cafe will automatically have their buffs applied during the next day cycle. "
fit_content = true
scroll_active = false

